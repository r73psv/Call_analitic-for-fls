# 152-ФЗ Шифрование локального хранилища (AES-256-GCM: 32 байта hex = 64 hex-символа)
# Сгенерировать: openssl rand -hex 32
STORE_ENCRYPTION_KEY=

# Пароль главного администратора (при чистом старте/деплое)
ADMIN_PASSWORD=admin123

# Название салона красоты (бренд для отчетов, промптов и автоинформатора 152-ФЗ)
SALON_NAME=Fashion Look Studio

# Выбор модели транскрибации речи по умолчанию: yandex_speechkit | tbank_voicekit | gigaam_v3
STT_PROVIDER=yandex_speechkit

# Файл сохранения переменных окружения на сервере (секреты, введённые после деплоя)
ENV_FILE_PATH=/app/data/.env

# Yandex Cloud (Авторизованный ключ сервисного аккаунта для IAM токенов и SpeechKit)
YC_FOLDER_ID=
YC_API_KEY=
YC_SERVICE_ACCOUNT_ID=
YC_SERVICE_ACCOUNT_KEY_FILE=/app/keys/authorized_key.json
YC_SERVICE_ACCOUNT_KEY_JSON=

# T-Bank VoiceKit (Тинькофф / Т-Банк Облако Speech-to-Text)
TBANK_VOICEKIT_API_KEY=
TBANK_VOICEKIT_SECRET_KEY=
TBANK_VOICEKIT_ENDPOINT=https://api.tbank.ru

# GigaASR (Cloud.ru Evolution) / GigaAM v3 (SaluteDevices / Sber ASR)
# Для Cloud.ru Evolution: https://foundation-models.api.cloud.ru/v1/audio/transcriptions
GIGAAM_API_URL=https://foundation-models.api.cloud.ru/v1/audio/transcriptions
GIGAAM_API_KEY=
# Допустимые варианты: GigaChat/GigaASR | GigaChat/SaluteSpeech | openai/whisper-large-v3 (Cloud.ru Evolution) | e2e_rnnt | e2e_ctc | rnnt | ctc
GIGAAM_MODEL_VARIANT=e2e_rnnt
# Глобальный лимит одновременных запросов к ASR (Cloud.ru Evolution базовый лимит организации до 20 RPS; по умолчанию 1 — строгий FIFO против 429)
ASR_MAX_CONCURRENT=1

# Yandex Object Storage (бакет для временного размещения длинных аудиозаписей SpeechKit >= 1MB)
# Используется только для SpeechKit и удаляется сразу после распознавания
YC_STORAGE_BUCKET=
YC_STORAGE_ACCESS_KEY=
YC_STORAGE_SECRET_KEY=
YC_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YC_STORAGE_REGION=ru-central1

# S3 Timeweb Cloud — изолированное резервное хранилище базы данных (AES-256-GCM зашифровано, 152-ФЗ)
S3_ENDPOINT=https://s3.timeweb.cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_KEY_PREFIX=lik28/data/
S3_REGION=ru-1
S3_SYNC_INTERVAL_SEC=300
S3_SYNC_DEBOUNCE_MS=45000
S3_SYNC_BATCH_SIZE=15

# GigaChat (Сбер) — Авторизационные данные (Base64 Client ID + Client Secret)
GIGACHAT_AUTH_KEY=
GIGACHAT_CREDENTIALS=
# Допустимые модели: GigaChat:Lite, GigaChat:Pro, GigaChat:Max, GigaChat:Ultra (по умолчанию для анализа: GigaChat:Ultra)
GIGACHAT_MODEL=GigaChat:Ultra
# Scope: GIGACHAT_API_PERS (физлица) или GIGACHAT_API_B2B (юрлица / ИП)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Мегафон ВАТС
# Версия протокола: json_rpc (классический data-api.cp.megafon.ru) или rest_wcgp (REST CRM API / sys/crm_api.wcgp)
MEGAFON_API_VERSION=json_rpc
# Для версии JSON-RPC:
MEGAFON_TOKEN=
# Для версии REST CRM API (WCGP):
MEGAFON_REST_DOMAIN=
MEGAFON_REST_TOKEN=
MEGAFON_CRM_TOKEN=
MEGAFON_LK_LOGIN=
MEGAFON_LK_PASSWORD=

# ВКонтакте (Оповещения управляющего и ежедневная сводка после 21:00, 152-ФЗ обезличенные)
VK_TOKEN=
VK_CHAT_ID=
VK_DAILY_REPORT_ENABLED=true
VK_DAILY_REPORT_TIME=21:05
SALON_TIMEZONE=Europe/Samara

# YClients (только чтение списка мастеров салона — ежедневное обновление в 08:00, запись отключена)
YCLIENTS_LOGIN=
YCLIENTS_PASSWORD=
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_SALON_ID=
YCLIENTS_MASTERS_SYNC_TIME=08:00

# Порт приложения
PORT=3000
HOST=0.0.0.0

# 152-ФЗ Регламентные сроки хранения (в днях, по умолчанию 30 дней)
TTL_LOG_DAYS=30
TTL_TEMP_DAYS=30
TTL_AUDIO_DAYS=30
